{
  "$comment": [
    "Install docs and the brand layer, pulled at build time so this site never",
    "keeps a second copy of something that is canonical elsewhere. Bump a `ref`",
    "when the source tags a release this site should pick up — `make sync` then",
    "refreshes the copies and the build uses them."
  ],
  "theme": {
    "$comment": [
      "Cadasto/docs-theme files written onto their live MkDocs paths. Those",
      "destinations are gitignored; bump `ref` to pick up a brand release."
    ],
    "repo": "Cadasto/docs-theme",
    "ref": "v0.1.0",
    "files": [
      {"path": "tokens.css", "dest": "pages/stylesheets/tokens.css"},
      {"path": "material.css", "dest": "pages/stylesheets/material.css"},
      {"path": "landing.css", "dest": "pages/stylesheets/landing.css"},
      {"path": "overrides/home.html", "dest": "overrides/home.html"},
      {"path": "overrides/partials/copyright.html", "dest": "overrides/partials/copyright.html"},
      {"path": "assets/cadasto-mark.png", "dest": "pages/assets/cadasto-mark.png"}
    ]
  },
  "sources": [
    {
      "name": "server-install",
      "repo": "Cadasto/openehr-assistant-mcp",
      "ref": "0.20.0",
      "path": "docs/install.md",
      "heading_shift": 1,
      "drop_first_heading": true
    },
    {
      "name": "plugin-install",
      "repo": "Cadasto/openehr-assistant-plugin",
      "ref": "v0.9.2",
      "path": "docs/install.md",
      "heading_shift": 1,
      "drop_first_heading": true
    }
  ]
}
