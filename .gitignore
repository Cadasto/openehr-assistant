# Built site
/site/

# Docs fetched from the product repositories at build time (see sources.json)
/.fetched/

# MkDocs plugin cache (privacy plugin's localised fonts)
/.cache/

# Python bytecode
__pycache__/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json

# Vale style packages, downloaded by `vale sync`. `styles/*` rather than
# `styles/`: git cannot re-include a path whose parent directory is itself
# excluded, so the negation below would never fire. The vocabulary is source and
# stays tracked.
styles/*
!styles/config/
